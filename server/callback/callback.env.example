# Скопируйте на VDS: sudo cp callback.env.example /etc/heavy/callback.env
# Пароль — «Пароль для внешнего приложения» в настройках mail.ru (не основной пароль).

CALLBACK_BIND=127.0.0.1
CALLBACK_PORT=8787

SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=lead-elephant@mail.ru
SMTP_PASS=ваш_пароль_приложения
MAIL_TO=lead-elephant@mail.ru

# Необязательно: если задан, фронт должен слать заголовок X-Callback-Secret
# CALLBACK_SECRET=
