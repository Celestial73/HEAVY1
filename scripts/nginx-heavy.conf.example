# Пример для Ubuntu: /etc/nginx/sites-available/heavy
# root → dist/ в клоне репозитория. После certbot подставьте свои server_name и пути к сертификату.
#
#   sudo cp /var/www/heavy/scripts/nginx-heavy.conf.example /etc/nginx/sites-available/heavy
#   sudo nano /etc/nginx/sites-available/heavy
#   sudo ln -sf /etc/nginx/sites-available/heavy /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

# HTTP → HTTPS (важно для ссылок из Telegram и мессенджеров)
server {
    listen 80;
    listen [::]:80;
    server_name
        xn----8sbeacptfrhsmqu2f2d.xn--p1ai
        www.xn----8sbeacptfrhsmqu2f2d.xn--p1ai
        xn----ctbaxcejgoege4ah4e5d.xn--p1ai
        www.xn----ctbaxcejgoege4ah4e5d.xn--p1ai
        lead-elephant.ru
        www.lead-elephant.ru;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name
        xn----8sbeacptfrhsmqu2f2d.xn--p1ai
        www.xn----8sbeacptfrhsmqu2f2d.xn--p1ai
        xn----ctbaxcejgoege4ah4e5d.xn--p1ai
        www.xn----ctbaxcejgoege4ah4e5d.xn--p1ai
        lead-elephant.ru
        www.lead-elephant.ru;

    root /var/www/heavy/dist;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/xn----8sbeacptfrhsmqu2f2d.xn--p1ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xn----8sbeacptfrhsmqu2f2d.xn--p1ai/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    ssl_session_cache shared:SSL:10m;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
